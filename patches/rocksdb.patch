+    PNMCompactionOffloadListener() : fd_(-1), base_(nullptr) {
+      fd_ = open("/dev/pnm", O_RDWR | O_SYNC);
+      if (fd_ < 0) {
+        fprintf(stderr, "[pnm] /dev/pnm not available (%s) — "
+                "offload disabled\n", strerror(errno));
+        return;
+      }
+      base_ = static_cast<volatile uint8_t*>(
+          mmap(nullptr, kPNMSize, PROT_READ | PROT_WRITE, MAP_SHARED, fd_, 0));
+      if (base_ == MAP_FAILED) {
+        fprintf(stderr, "[pnm] mmap failed (%s)\n", strerror(errno));
+        close(fd_);
