@@ -293,6 +307,33 @@ BridgeBase::BridgeResponsePort::trySendTiming()
 
     PacketPtr pkt = resp.pkt;
 
+    // Defensive: some X86 IO devices fail to call makeAtomicResponse(),
+    // delivering a request into the response queue.  Convert it here so
+    // sendTimingResp() doesn't assert pkt->isResponse().
+    // makeResponse() internally asserts needsResponse() && isRequest(), so
+    // guard both conditions.  If the packet cannot be converted, dequeue
+    // and discard rather than crashing.
+    if (!pkt->isResponse()) {
+        if (pkt->isRequest() && pkt->needsResponse()) {
+            pkt->makeResponse();
+        } else {
+            // Non-convertible orphan — discard without sending
+            transmitList.pop_front();
+            assert(outstandingResponses != 0);
+            --outstandingResponses;
+            if (!transmitList.empty()) {
+                bridge.schedule(sendEvent,
+                    std::max(transmitList.front().tick, bridge.clockEdge()));
+            }
+            if (!memSidePort.reqQueueFull() && retryReq) {
+                retryReq = false;
+                sendRetryReq();
+            }
+            delete pkt;
+            return;
+        }
+    }
+
     DPRINTF(Bridge, "trySend response addr 0x%x, outstanding %d\n",
             pkt->getAddr(), outstandingResponses);
 
